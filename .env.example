# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cybershield:password@localhost:5432/cybershield_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── MinIO Object Storage ──────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=cybershield-media

# ─── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production
ENCRYPTION_KEY=your-32-byte-fernet-encryption-key-here==

# ─── Roboflow AI Models ────────────────────────────────────────────────────────
# Get API key from: https://app.roboflow.com → Settings → API Keys
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Your Roboflow workspace slug (from app.roboflow.com URL)
ROBOFLOW_WORKSPACE=your_workspace_slug

# Specific Workflow / Model IDs for 5 CCTV Analytics categories
ROBOFLOW_PLATE_ID=license-plate-recognition-mshun/1
ROBOFLOW_FACE_ID=face-detection-jv96r/1
ROBOFLOW_GENDER_ID=gender-classification-xd7pk/2
ROBOFLOW_TRAFFIC_ID=traffic-analysis-vst8k/1
ROBOFLOW_VIOLENCE_ID=violence-detection-fkwj1/1

# How many video frames to skip between Roboflow inference calls (default: 30 = 1 per second at 30fps)
FRAME_SAMPLE_RATE=30

# ─── Alert Channels ────────────────────────────────────────────────────────────
# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
ALERT_PHONE_NUMBERS=+919876543210,+919876543211

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_IDS=chat_id_1,chat_id_2

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL_RECIPIENTS=admin@police.gov.in

# ─── Map & Geo ─────────────────────────────────────────────────────────────────
# Map uses CARTO Dark Matter tiles (free, no key needed)
# Mapbox is optional — only needed if you switch to a Mapbox style
MAPBOX_API_KEY=

# Chennai city map defaults
MAP_CENTER_LAT=13.0827
MAP_CENTER_LON=80.2707
MAP_DEFAULT_ZOOM=12

# ─── AI Model Thresholds ───────────────────────────────────────────────────────
VIOLENCE_THRESHOLD=0.75
VEHICLE_DETECTION_THRESHOLD=0.80
FACIAL_RECOGNITION_THRESHOLD=0.85
CROWD_DENSITY_ALERT_THRESHOLD=150
